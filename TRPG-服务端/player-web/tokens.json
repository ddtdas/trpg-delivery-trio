{
  "$schema": "trpg-design-tokens/2.0",
  "_meta": {
    "version": "2.0.0",
    "theme": "modu-dark（魔都TRPG 暗色）",
    "supersedes": "1.31",
    "source": "https://www.cnmods.net/web/",
    "method": "ego-browser(Chrome) 打开参考站 → getComputedStyle 运行时实测 + 站点 CSS/JS 主题覆盖静态核验",
    "measuredAt": "2026-09-27T05:2x+08:00",
    "contract": "docs/CROSS-END-CONTRACT.md §2 —— 键名与 v1.31 完全兼容（仅换值），新键为增量追加",
    "consumers": [
      "TRPG-服务端/player-web/app.css",
      "TRPG-Web客户端/client/app.css",
      "TRPG-微信小程序客户端/tokens.wxss",
      "TRPG-服务端/web/dist/assets/theme-cnmods.css"
    ],
    "deviations": {
      "layout.tapMin": "44px —— WCAG 触控最小尺寸；参考站中号控件为 34px（layout.controlMd）。仅移动端交互控件保留 44px。",
      "layout.maxWidth": "560px —— 玩家端为手机竖屏单列；参考站为桌面优先（html{min-width:1440px}，内容列 1120px）。桌面网格不适用于玩家端。",
      "layout.sidebar": "none —— 玩家端无侧栏；参考站侧栏 260px。",
      "color.cardTranslucent + layout.blur": "面板半透明 rgba(20,28,35,0.73) + backdrop-filter blur(8px) 是参考站 /web/moduleDetail 的实测形态（无边框、无阴影）。微信小程序的 backdrop-filter 支持不稳定，MP 端 .card 退化为不透明 color.card（#141c23，同色同相），已在 app.wxss 注明。",
      "color.card 的不透明/半透明双形态": "参考站两种都存在：首页侧栏 bg-[#141C23] 不透明（radius 0），详情页面板 bg-[#141c23ba] 半透明+blur（radius 4px）。本项目取详情页形态作为主面板（color.cardTranslucent），取不透明形态用于列表行/侧栏/GM 侧边栏（color.card）。"
    }
  },
